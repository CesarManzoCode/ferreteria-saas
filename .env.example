# ============================================================
# FERRETERÍA SAAS — Variables de entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA commitees el .env real a git
# ============================================================

# --- Base de datos ---
# Formato: postgresql://usuario:password@host:puerto/nombre_db
DATABASE_URL=postgresql://ferreteria_user:tu_password_aqui@db:5432/ferreteria_db

# --- Seguridad ---
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_un_string_aleatorio_largo_de_64_caracteres

# --- Aplicación ---
DEBUG=false
# Orígenes permitidos para CORS (el frontend)
# En producción: tu dominio real, ej: https://tuapp.mx
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- PostgreSQL (para docker-compose) ---
POSTGRES_DB=ferreteria_db
POSTGRES_USER=ferreteria_user
POSTGRES_PASSWORD=cambia_este_password_en_produccion
